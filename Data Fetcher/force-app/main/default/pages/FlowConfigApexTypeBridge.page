<apex:page
  showHeader="false"
  sidebar="false"
  standardStylesheets="false"
  applyHtmlTag="false"
  applyBodyTag="false"
  cache="false"
>
  <html>
    <head>
      <meta charset="utf-8" />
      <title>Apex Type Metadata Bridge</title>
    </head>
    <body>
      <script>
        (function () {
          "use strict";

          var CHANNEL = "flow-config-apex-type";
          var API_VERSION = "67.0";
          var SESSION_ID = "{!JSENCODE($Api.Session_ID)}";
          var PARENT_ORIGIN =
            "{!JSENCODE($CurrentPage.parameters.parentOrigin)}";

          var TRUSTED_PARENT_SUFFIXES = [
            ".lightning.force.com",
            ".lightning.salesforce.com",
            ".salesforce.com"
          ];

          function isTrustedParent(origin) {
            try {
              var parsed = new URL(origin);
              if (parsed.protocol !== "https:") {
                return false;
              }
              var host = parsed.hostname.toLowerCase();
              return TRUSTED_PARENT_SUFFIXES.some(function (suffix) {
                return host.endsWith(suffix);
              });
            } catch (error) {
              return false;
            }
          }

          function parseIdentity(value) {
            var normalized = String(value || "")
              .trim()
              .replace(/^apex:\/\//i, "")
              .replace(/[{}\[\]]/g, "")
              .replace(/[\/:]/g, ".");
            if (!/^[A-Za-z_][A-Za-z0-9_.]*$/.test(normalized)) {
              throw new Error("Invalid Apex class name.");
            }
            var namespace = null;
            var className = normalized;
            var namespaceSeparator = normalized.indexOf("__");
            if (namespaceSeparator > 0) {
              namespace = normalized.substring(0, namespaceSeparator);
              className = normalized.substring(namespaceSeparator + 2);
            } else {
              var parts = normalized.split(".");
              if (parts.length === 2) {
                namespace = parts[0];
                className = parts[1];
              }
            }
            return { namespace: namespace, className: className };
          }

          function escapeSoql(value) {
            return String(value).replace(/\\/g, "\\\\").replace(/'/g, "\\'");
          }

          function humanize(value) {
            var label = String(value).replace(/([a-z0-9])([A-Z])/g, "$1 $2");
            return label.charAt(0).toUpperCase() + label.slice(1);
          }

          function annotationName(annotation) {
            if (typeof annotation === "string") {
              return annotation;
            }
            return annotation ? annotation.name : "";
          }

          function isAuraEnabled(member) {
            return (member.annotations || []).some(function (annotation) {
              return (
                String(annotationName(annotation)).toLowerCase() ===
                "auraenabled"
              );
            });
          }

          function normalizeMember(member, namespace) {
            var sourceType = String(member.type || "String").replace(
              /\s+/g,
              ""
            );
            var valueType = sourceType;
            var isCollection = false;
            if (/\[\]$/.test(valueType)) {
              isCollection = true;
              valueType = valueType.slice(0, -2);
            }
            var collectionPattern =
              "^(?:List|Set)" +
              String.fromCharCode(60) +
              "(.+)" +
              String.fromCharCode(62) +
              "$";
            var collectionMatch = valueType.match(
              new RegExp(collectionPattern, "i")
            );
            if (collectionMatch) {
              isCollection = true;
              valueType = collectionMatch[1];
            }
            var normalized = valueType.toLowerCase();
            var dataType = "Apex";
            var apexClass = null;
            var objectType = null;
            if (
              ["decimal", "double", "integer", "long"].indexOf(normalized) !==
              -1
            ) {
              dataType = "Number";
            } else if (normalized === "boolean") {
              dataType = "Boolean";
            } else if (normalized === "date") {
              dataType = "Date";
            } else if (normalized === "datetime") {
              dataType = "DateTime";
            } else if (normalized === "time") {
              dataType = "Time";
            } else if (["string", "id"].indexOf(normalized) !== -1) {
              dataType = "String";
            } else if (/^schema\./i.test(valueType)) {
              dataType = "SObject";
              objectType = valueType.replace(/^schema\./i, "");
            } else {
              apexClass = valueType;
              if (apexClass.indexOf(".") > 0) {
                apexClass = apexClass.replace(".", "__");
              } else if (namespace) {
                if (apexClass.indexOf("__") === -1) {
                  apexClass = namespace + "__" + apexClass;
                }
              }
            }
            return {
              name: member.name,
              label: humanize(member.name),
              dataType: dataType,
              apexClass: apexClass,
              objectType: objectType,
              isCollection: isCollection,
              sourceType: sourceType
            };
          }

          async function describeType(apexClassName) {
            var identity = parseIdentity(apexClassName);
            var query =
              "SELECT Name, NamespacePrefix, SymbolTable FROM ApexClass WHERE Name = '" +
              escapeSoql(identity.className) +
              "'";
            if (identity.namespace) {
              query +=
                " AND NamespacePrefix = '" +
                escapeSoql(identity.namespace) +
                "'";
            }
            var payload = await toolingQuery(query);
            var records = payload.records || [];
            if (!identity.namespace) {
              if (records.length !== 1) {
                throw new Error(
                  "The Apex-defined type could not be resolved unambiguously."
                );
              }
            }
            var record = records[0];
            if (!record) {
              throw new Error("The Apex-defined type was not found.");
            }
            var symbolTable = record.SymbolTable || {};
            return (symbolTable.properties || [])
              .concat(symbolTable.variables || [])
              .filter(isAuraEnabled)
              .map(function (member) {
                return normalizeMember(member, record.NamespacePrefix);
              });
          }

          async function toolingQuery(query) {
            var response = await fetch(
              "/services/data/v" +
                API_VERSION +
                "/tooling/query/?q=" +
                encodeURIComponent(query),
              {
                method: "GET",
                credentials: "same-origin",
                headers: {
                  Authorization: "Bearer " + SESSION_ID,
                  Accept: "application/json"
                }
              }
            );
            if (!response.ok) {
              throw new Error(
                "Tooling API request failed (" + response.status + ")."
              );
            }
            return response.json();
          }

          async function describeFlowElements(flowId) {
            var normalizedId = String(flowId || "").trim();
            if (!/^(?:300|301)[a-zA-Z0-9]{12,15}$/.test(normalizedId)) {
              throw new Error("Invalid Flow version or definition ID.");
            }
            var condition =
              normalizedId.indexOf("301") === 0
                ? "Id = '" + escapeSoql(normalizedId) + "'"
                : "DefinitionId = '" + escapeSoql(normalizedId) + "'";
            var query =
              "SELECT Id, Metadata FROM Flow WHERE " +
              condition +
              " ORDER BY VersionNumber DESC LIMIT 1";
            var payload = await toolingQuery(query);
            var metadata = payload.records?.[0]?.Metadata || {};
            var groups = [
              {
                key: "subflows",
                kind: "Subflow",
                iconName: "utility:flow"
              },
              {
                key: "actionCalls",
                kind: "Action",
                iconName: "utility:fallback"
              },
              {
                key: "apexPluginCalls",
                kind: "Apex Action",
                iconName: "utility:apex"
              },
              {
                key: "transforms",
                kind: "Transform",
                iconName: "utility:transform"
              },
              {
                key: "collectionProcessors",
                kind: "Collection Processor",
                iconName: "utility:collection"
              }
            ];
            var elements = [];
            groups.forEach(function (group) {
              (metadata[group.key] || []).forEach(function (element) {
                if (element.name) {
                  elements.push({
                    name: element.name,
                    label: element.label || element.name,
                    kind: group.kind,
                    iconName: group.iconName
                  });
                }
              });
            });
            return elements;
          }

          async function describeCustomLabels() {
            var payload = await toolingQuery(
              "SELECT Name, MasterLabel, NamespacePrefix FROM ExternalString ORDER BY MasterLabel"
            );
            var records = payload.records || [];
            while (!payload.done && payload.nextRecordsUrl) {
              var response = await fetch(payload.nextRecordsUrl, {
                method: "GET",
                credentials: "same-origin",
                headers: {
                  Authorization: "Bearer " + SESSION_ID,
                  Accept: "application/json"
                }
              });
              if (!response.ok) {
                throw new Error(
                  "Tooling API request failed (" + response.status + ")."
                );
              }
              payload = await response.json();
              records = records.concat(payload.records || []);
            }
            return records.map(function (record) {
              var developerName = record.NamespacePrefix
                ? String(record.Name).replace(
                    new RegExp("^" + record.NamespacePrefix + "_"),
                    ""
                  )
                : record.Name;
              var path = record.NamespacePrefix
                ? "$Label." + record.NamespacePrefix + "." + developerName
                : "$Label." + developerName;
              return {
                name: path,
                label: record.MasterLabel || developerName,
                dataType: "String",
                isCollection: false
              };
            });
          }

          // parentOrigin arrives as a URL parameter, so it is untrusted input.
          // Refuse to install the listener at all unless it resolves to a
          // Salesforce origin. Without this guard a page that frames the bridge
          // could name its own origin and read back Tooling API results.
          if (!isTrustedParent(PARENT_ORIGIN)) {
            return;
          }

          window.addEventListener("message", async function (event) {
            if (
              event.source !== window.parent ||
              event.origin !== PARENT_ORIGIN ||
              !isTrustedParent(event.origin)
            ) {
              return;
            }
            var message = event.data;
            if (!message || message.channel !== CHANNEL) {
              return;
            }
            try {
              var result;
              var responseKey;
              if (message.action === "describeApexType") {
                result = await describeType(message.apexClassName);
                responseKey = "members";
              } else if (message.action === "describeFlowElements") {
                result = await describeFlowElements(message.flowId);
                responseKey = "elements";
              } else if (message.action === "describeCustomLabels") {
                result = await describeCustomLabels();
                responseKey = "labels";
              } else {
                return;
              }
              var responseMessage = {
                channel: CHANNEL,
                action: "result",
                requestId: message.requestId,
                success: true
              };
              responseMessage[responseKey] = result;
              window.parent.postMessage(responseMessage, PARENT_ORIGIN);
            } catch (error) {
              window.parent.postMessage(
                {
                  channel: CHANNEL,
                  action: "result",
                  requestId: message.requestId,
                  success: false,
                  error:
                    error.message || "Unable to inspect the Apex-defined type."
                },
                PARENT_ORIGIN
              );
            }
          });

          window.parent.postMessage(
            { channel: CHANNEL, action: "ready" },
            PARENT_ORIGIN
          );
        })();
      </script>
    </body>
  </html>
</apex:page>
